DATABASE_URL=file:blog.db
# Production can use a standard libSQL/Turso database instead:
# TURSO_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-token
PAYLOAD_SECRET=replace-with-at-least-32-random-bytes
